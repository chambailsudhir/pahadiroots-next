# pahadiroots-next — environment contract (names only; values live in Vercel → mark every secret "Sensitive").
# Required
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=            # Sensitive. Server only.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=             # Sensitive
RAZORPAY_WEBHOOK_SECRET=         # Sensitive. Production + any preview that receives webhooks (webhook fails closed without it).
RESEND_API_KEY=                  # Sensitive
CRON_SECRET=                     # Sensitive. Bearer for /api/v1/cron/* (also used by an external scheduler for the 10-min expiry sweep on Hobby plan)
REVALIDATE_SECRET=               # Sensitive
NEXT_PUBLIC_SITE_URL=https://www.pahadiroots.com
ADMIN_EMAIL=
# Optional
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=        # Sensitive. Rate limiting fails CLOSED for mutations when both KV and DB fallback error.
ANTHROPIC_API_KEY=               # Sensitive
GEMINI_API_KEY=                  # Sensitive
APP_VERSION=
NEXT_PUBLIC_APP_VERSION=
# Test-only (never in Vercel): DATABASE_URL / SUPABASE_DB_URL / SUPABASE_TEST_DB_URL for DB-contract tests against a scratch DB.
