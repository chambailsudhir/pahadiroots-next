# pahadiroots-next — environment contract (names only; values live in Vercel → mark every secret "Sensitive").
# Required
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=            # Sensitive. Server only.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=             # Sensitive
RAZORPAY_WEBHOOK_SECRET=         # Sensitive. Production + any preview that receives webhooks (webhook fails closed without it).
RESEND_API_KEY=                  # Sensitive
CRON_SECRET=                     # Sensitive. Bearer for /api/v1/cron/* (also used by an external scheduler for the 10-min expiry sweep on Hobby plan)
REVALIDATE_SECRET=               # Sensitive
NEXT_PUBLIC_SITE_URL=https://www.pahadiroots.com
ADMIN_EMAIL=
# Optional
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=        # Sensitive. Rate limiting fails CLOSED for mutations when both KV and DB fallback error.
ANTHROPIC_API_KEY=               # Sensitive
GEMINI_API_KEY=                  # Sensitive
APP_VERSION=
NEXT_PUBLIC_APP_VERSION=
# Test-only (never in Vercel): DATABASE_URL / SUPABASE_DB_URL / SUPABASE_TEST_DB_URL for DB-contract tests against a scratch DB.

# Chat bot challenge (lib/api/chatChallenge.ts). Default: proof of work, no account needed.
CHAT_POW_BITS=18                 # 8-26; higher = more work per chat session
# Optional real CAPTCHA (Cloudflare Turnstile, free). Set BOTH to switch the chat to Turnstile:
TURNSTILE_SECRET_KEY=            # Sensitive
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Phone verification by WhatsApp (feature is OFF until all three are set; see docs/account-audit-2026-11.md)
WHATSAPP_VERIFY_NUMBER=          # the shop's WhatsApp Business number customers message, e.g. 919800000000
WHATSAPP_APP_SECRET=             # Sensitive. Meta app secret (webhook signature)
WHATSAPP_VERIFY_TOKEN=           # Sensitive. Token you type in Meta's webhook configuration
# Chat bot
CHAT_TOKEN_SECRET=               # Sensitive. Signs chat session tokens (falls back to the Supabase service key when unset)
GEMINI_MODEL=gemini-3.8-flash    # Google retires models: change here, no deploy needed
# Order / deploy tuning (optional)
ORDER_CREATE_BUDGET_MS=          # overall budget of POST /api/v1/orders before it answers 503 (default in code)
WAIT_FOR_DB_TOTAL_MS=            # scripts/wait-for-db.cjs: give up after this long (default 180000)
WAIT_FOR_DB_EVERY_MS=            # scripts/wait-for-db.cjs: retry interval

