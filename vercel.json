{
  "framework": "nextjs",
  "regions": [
    "bom1"
  ],
  "buildCommand": "node scripts/wait-for-db.cjs && next build",
  "outputDirectory": ".next",
  "installCommand": "npm ci",
  "ignoreCommand": "if [ \"$VERCEL_ENV\" != \"production\" ]; then exit 0; fi; [ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] || exit 1; git cat-file -e \"$VERCEL_GIT_PREVIOUS_SHA\" 2>/dev/null || exit 1; git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- . ':(exclude)docs' ':(exclude)*.md' ':(exclude)src/__tests__' ':(exclude).github'",
  "functions": {
    "src/app/api/v1/orders/route.ts": {
      "maxDuration": 40
    },
    "src/app/api/v1/payments/route.ts": {
      "maxDuration": 40
    },
    "src/app/api/v1/webhook/razorpay/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/v1/cron/retry-failed-emails/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/health/route.ts": {
      "maxDuration": 10
    },
    "src/app/api/v1/cron/expire-pending-orders/route.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/v1/cron/expire-pending-orders",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/v1/cron/retry-failed-emails",
      "schedule": "0 4 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/v1/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
